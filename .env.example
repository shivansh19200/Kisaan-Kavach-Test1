# PayPal Sandbox (REQUIRED for real money flows)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM API (OpenAI-compatible base URL; the app adds /chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Session
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

# App
DEMO_MODE=true
PAYPAL_DEMO_MODE=true
APP_URL=http://localhost:3000
CAPTURE_MODE=TWO_STAGE
ADVANCE_PCT=30

# PayPal hold/reauth settings
HOLD_DEFAULT_DAYS=29
HONOR_DAYS=3
DISPUTE_WINDOW_DAYS=7
DISPUTE_WINDOW_MINUTES_DEMO=10

# Lab registry (JSON string of {kid: publicKeyPem})
LAB_REGISTRY_PUBLIC_KEYS={}

# Languages
SUPPORTED_LANGS=en,hi,mr
DEFAULT_LANG=en
